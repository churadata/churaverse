# Dev: requests proxied through Vite dev server to the individual services (see vite.config.ts server.proxy)
SERVER_DOMAIN=localhost:3000

# ログレベル: debug | info | warn | error
# debug: 全てのログを表示（RTCStats詳細ログなど含む）
# warn: 警告以上のみ（デフォルト）
VITE_LOG_LEVEL=warn

# httpsで接続する場合はhttpsとwssに変更する
VITE_BACKEND_URL=http://${SERVER_DOMAIN}/backend
VITE_BACKEND_LIVEKIT_URL=http://${SERVER_DOMAIN}/backend_livekit
VITE_LIVEKIT_URL=ws://${SERVER_DOMAIN}/livekit
