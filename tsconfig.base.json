{
  "compilerOptions": {
    "target": "ES2022",
    "incremental": true,
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // 副作用 import(import 'x')も解決できるか検査する。exports で公開していないサブパスを検出するため
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true
  }
}
